rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== PASSWORD ADMIN (padam ranking) =====
    // Tukar password: ubah 'prokuiz2026' di bawah (SATU tempat sahaja), kemudian Publish.
    function adminPassword() { return 'prokuiz2026'; }

    // Tetapan app (musim ranking) — 'app' = ProSudoku, 'chess' = ProChess, 'fight' = ProFighter, 'strike' = ProStrike
    match /config/{docId} {
      allow read: if true;
      allow create, update: if request.auth != null && docId in ['app', 'chess', 'fight', 'strike'] && (
            // Reset ranking: mesti hantar password yang betul
            (request.resource.data.key == adminPassword() && request.resource.data.season is int)
            // Selepas reset, app buang password dari dokumen (musim tak berubah)
         || (resource != null && !('key' in request.resource.data)
             && request.resource.data.season == resource.data.season)
      );
    }

    // Profil & ranking pemain — semua boleh baca, hanya pemilik boleh tulis
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.name is string
                   && request.resource.data.name.size() <= 14
                   && request.resource.data.rating is int
                   && request.resource.data.rating < 5000;
    }

    // Siapa online (untuk senarai pemain online)
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Ajakan lawan 1v1
    match /invites/{id} {
      allow read: if request.auth != null
                  && (resource.data.to == request.auth.uid || resource.data.from.uid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from.uid == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.to == request.auth.uid || resource.data.from.uid == request.auth.uid);
      allow delete: if request.auth != null && resource.data.from.uid == request.auth.uid;
    }

    // Perlawanan 1v1
    match /matches/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.p1.uid == request.auth.uid;
      allow update: if request.auth != null && (
                       resource.data.p1.uid == request.auth.uid
                    || (resource.data.p2 != null && resource.data.p2.uid == request.auth.uid)
                    || (resource.data.p2 == null && request.resource.data.p2.uid == request.auth.uid));
      allow delete: if request.auth != null && resource.data.p1.uid == request.auth.uid;
    }

    // =========================================================
    // ===== PROCHESS (koleksi berasingan, tak kacau ProSudoku) =====
    // =========================================================
    match /chess_players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.name is string
                   && request.resource.data.name.size() <= 14
                   && request.resource.data.rating is int
                   && request.resource.data.rating < 5000;
    }
    match /chess_presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /chess_invites/{id} {
      allow read: if request.auth != null
                  && (resource.data.to == request.auth.uid || resource.data.from.uid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from.uid == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.to == request.auth.uid || resource.data.from.uid == request.auth.uid);
      allow delete: if request.auth != null && resource.data.from.uid == request.auth.uid;
    }
    match /chess_matches/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.p1.uid == request.auth.uid;
      allow update: if request.auth != null && (
                       resource.data.p1.uid == request.auth.uid
                    || (resource.data.p2 != null && resource.data.p2.uid == request.auth.uid)
                    || (resource.data.p2 == null && request.resource.data.p2.uid == request.auth.uid));
      allow delete: if request.auth != null && resource.data.p1.uid == request.auth.uid;
    }

    // =========================================================
    // ===== PROFIGHTER (koleksi berasingan, tak kacau ProSudoku/ProChess) =====
    // =========================================================
    match /fight_players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.name is string
                   && request.resource.data.name.size() <= 14
                   && request.resource.data.rating is int
                   && request.resource.data.rating < 5000;
    }
    match /fight_presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /fight_invites/{id} {
      allow read: if request.auth != null
                  && (resource.data.to == request.auth.uid || resource.data.from.uid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from.uid == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.to == request.auth.uid || resource.data.from.uid == request.auth.uid);
      allow delete: if request.auth != null && resource.data.from.uid == request.auth.uid;
    }
    match /fight_matches/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.p1.uid == request.auth.uid;
      allow update: if request.auth != null && (
                       resource.data.p1.uid == request.auth.uid
                    || (resource.data.p2 != null && resource.data.p2.uid == request.auth.uid)
                    || (resource.data.p2 == null && request.resource.data.p2.uid == request.auth.uid));
      allow delete: if request.auth != null && resource.data.p1.uid == request.auth.uid;
      // Relay pertarungan (bila sambungan terus P2P tak dapat)
      match /relay/{doc} {
        allow read, write: if request.auth != null;
      }
    }

    // =========================================================
    // ===== PROSTRIKE (koleksi berasingan, tak kacau app lain) =====
    // =========================================================
    match /strike_players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.name is string
                   && request.resource.data.name.size() <= 14
                   && request.resource.data.rating is int
                   && request.resource.data.rating < 5000;
    }
    match /strike_presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /strike_invites/{id} {
      allow read: if request.auth != null
                  && (resource.data.to == request.auth.uid || resource.data.from.uid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from.uid == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.to == request.auth.uid || resource.data.from.uid == request.auth.uid);
      allow delete: if request.auth != null && resource.data.from.uid == request.auth.uid;
    }
    // Bilik / perlawanan pasukan (1v1, 2v2, 3v3) — ahli disenaraikan dalam 'uids'
    match /strike_matches/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.host == request.auth.uid
                    && request.auth.uid in request.resource.data.uids;
      allow update: if request.auth != null
                    && (request.auth.uid in resource.data.uids
                        || request.auth.uid in request.resource.data.uids);
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;
      // Isyarat WebRTC (P2P) & relay (bila P2P tak dapat)
      match /sig/{doc} {
        allow read, write: if request.auth != null;
      }
      match /relay/{doc} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
